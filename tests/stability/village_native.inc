    static std::shared_ptr<const StructurePlan> naturalPlan(World& w){
        for(int radius=0;radius<=32;++radius)for(int z=-radius;z<=radius;++z)for(int x=-radius;x<=radius;++x){if(radius&&std::max(std::abs(x),std::abs(z))!=radius)continue;
            auto p=w.structures_.majorPlanForRegion(x,z,[&](int X,int Z){return w.structureTerrainAt(X,Z);});if(p.pieces.empty()||(p.kind!=StructureKind::PlainsVillage&&p.kind!=StructureKind::DesertVillage)||p.pieces.size()<5)continue;
            std::set<unsigned> professions;for(const auto& piece:p.pieces)for(auto m:structureTemplate(piece.kind).mobs){if(m.hostile)continue;auto d=rotateLocalPosition(m.x,m.z,piece.rotation,piece.mirror);glm::ivec3 home(piece.x+d[0],piece.y+m.y,piece.z+d[1]);unsigned job=Villages::identity(w.seed(),w.generationVersion(),home.x,home.z,home)%4;
                auto want=job==0?StructurePieceKind::Farm:job==1?StructurePieceKind::Smith:job==2?StructurePieceKind::Storage:StructurePieceKind::Well;if(std::none_of(p.pieces.begin(),p.pieces.end(),[&](auto b){return b.kind==want;}))job=3;professions.insert(job);}
            if(professions.size()>=2)return w.structures_.peekMajorPlan(x,z);
        }throw std::runtime_error("No multi-profession native village in bounded fixture search");
    }
