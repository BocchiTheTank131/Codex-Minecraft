#include <winver.h>

1 ICON "@VOXEL_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Voxel Frontier Project\0"
            VALUE "FileDescription", "Voxel Frontier\0"
            VALUE "FileVersion", "@VOXELFRONTIER_DISPLAY_VERSION@\0"
            VALUE "InternalName", "VoxelFrontier\0"
            VALUE "OriginalFilename", "VoxelFrontier.exe\0"
            VALUE "ProductName", "Voxel Frontier\0"
            VALUE "ProductVersion", "@VOXELFRONTIER_DISPLAY_VERSION@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Voxel Frontier Project\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
